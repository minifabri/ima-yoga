NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Segreta: mai esporla al browser, serve solo per il reset password admin.
# Supabase → Project Settings → API → "service_role" secret key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Per l'email "classe piena" (facoltativo: se manca una delle due, l'avviso viene
# saltato senza bloccare la prenotazione). Crea un account gratuito su resend.com
# per ottenere la API key.
RESEND_API_KEY=your-resend-api-key
# Finché non verifichi un tuo dominio su Resend, lascia questo mittente di test.
RESEND_FROM_EMAIL=ima yoga <onboarding@resend.dev>
# Indirizzo a cui arrivano gli avvisi "classe piena".
ADMIN_NOTIFICATION_EMAIL=blasta.fb@gmail.com

# Usato nel link "Vai alla tua area" del promemoria lezione (vedi vercel.json,
# cron /api/cron/class-reminders). Facoltativo: senza, punta a ima-yoga.vercel.app.
NEXT_PUBLIC_SITE_URL=https://ima-yoga.vercel.app
# Facoltativa: se impostata, Vercel Cron la manda come "Authorization: Bearer ..."
# nelle chiamate al cron — impedisce che chiunque conosca l'URL possa lanciarlo
# manualmente. Su Vercel basta aggiungerla come env var, il cron la usa da solo.
CRON_SECRET=una-stringa-lunga-a-caso

# Manutenzione/coming soon: se "true", chiunque non sia loggato come admin viene
# reindirizzato a /manutenzione (login e cron restano sempre raggiungibili).
MAINTENANCE_MODE=false
